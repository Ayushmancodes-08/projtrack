# Supabase Configuration
# Project URL from Supabase dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (Settings > API > Project API keys)
# Supabase recommends the new publishable key format:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy anon key (backward-compatible fallback):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Service Role Key (Keep secret! Only for backend/cron scripts, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Resend API Key for invitations & notification emails
# RESEND_API_KEY=re_your_resend_api_key
